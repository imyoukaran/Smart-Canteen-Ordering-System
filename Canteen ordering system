
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Smart Canteen System</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f6f9;
    color: #222;
}

header {
    background: #142d24;
    color: white;
    padding: 20px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

header h1 {
    font-size: 25px;
}

nav button {
    background: transparent;
    color: white;
    border: 1px solid white;
    padding: 9px 15px;
    margin: 3px;
    border-radius: 6px;
    cursor: pointer;
}

nav button:hover {
    background: #36a269;
}

.hero {
    padding: 55px 7%;
    background: linear-gradient(120deg, #173c2d, #38a16a);
    color: white;
}

.hero h2 {
    font-size: 38px;
    margin-bottom: 12px;
}

.hero p {
    font-size: 17px;
}

.container {
    padding: 30px 6%;
}

.section-title {
    margin-bottom: 20px;
    font-size: 25px;
}

.controls {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 25px;
}

input, select, textarea {
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 7px;
    font-size: 15px;
}

#search {
    flex: 1;
    min-width: 200px;
}

button {
    cursor: pointer;
}

.categories {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 25px;
}

.category {
    border: none;
    background: white;
    padding: 10px 18px;
    border-radius: 20px;
    box-shadow: 0 2px 6px #ddd;
}

.category.active {
    background: #238b57;
    color: white;
}

.menu {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
}

.food-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 3px 12px #ddd;
    transition: 0.2s;
}

.food-card:hover {
    transform: translateY(-5px);
}

.food-image {
    height: 150px;
    background: #e9f4ed;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 75px;
}

.food-info {
    padding: 17px;
}

.food-info h3 {
    margin-bottom: 8px;
}

.price {
    color: #16824c;
    font-size: 20px;
    font-weight: bold;
    margin: 12px 0;
}

.btn {
    border: none;
    background: #218c55;
    color: white;
    padding: 11px 15px;
    border-radius: 6px;
    width: 100%;
    margin-top: 8px;
}

.btn:hover {
    background: #126b3d;
}

.btn:disabled {
    background: #999;
    cursor: not-allowed;
}

.panel {
    background: white;
    padding: 22px;
    border-radius: 12px;
    margin-bottom: 25px;
    box-shadow: 0 3px 12px #ddd;
}

.hidden {
    display: none !important;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid #ddd;
    padding: 15px 0;
    flex-wrap: wrap;
}

.cart-item button {
    padding: 5px 10px;
    border: none;
    background: #eee;
    border-radius: 5px;
}

.total {
    font-size: 18px;
    line-height: 2;
    margin-top: 15px;
}

.total strong {
    color: #16824c;
}

.admin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 12px;
    margin: 15px 0;
}

.order {
    border: 1px solid #ddd;
    padding: 15px;
    border-radius: 8px;
    margin: 12px 0;
}

.status {
    color: #16824c;
    font-weight: bold;
}

footer {
    background: #142d24;
    color: white;
    padding: 25px;
    text-align: center;
    margin-top: 40px;
}

#toast {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: #142d24;
    color: white;
    padding: 15px 22px;
    border-radius: 8px;
    display: none;
    z-index: 100;
}

@media(max-width:600px) {
    header {
        flex-direction: column;
    }

    .hero h2 {
        font-size: 28px;
    }
}
</style>
</head>

<body>

<header>
    <h1>🍔 Smart Canteen</h1>

    <nav>
        <button onclick="showPage('home')">Home</button>
        <button onclick="showPage('cart')">
            Cart (<span id="cartCount">0</span>)
        </button>
        <button onclick="showPage('orders')">My Orders</button>
        <button onclick="showPage('admin')">Admin</button>
    </nav>
</header>

<section class="hero">
    <h2>Hungry? Order Smart!</h2>
    <p>Order your favourite food online. Skip the queue and save time.</p>
    <br>
    <button class="btn" style="width:auto"
        onclick="showPage('home')">
        Explore Menu
    </button>
</section>

<main class="container">

<!-- HOME PAGE -->

<section id="home">

    <h2 class="section-title">Our Food Menu 🍕</h2>

    <div class="controls">
        <input id="search" type="text"
            placeholder="Search your favourite food..."
            oninput="renderMenu()">

        <select id="sort" onchange="renderMenu()">
            <option value="default">Sort by</option>
            <option value="low">Price: Low to High</option>
            <option value="high">Price: High to Low</option>
        </select>
    </div>

    <div class="categories" id="categories"></div>

    <div class="menu" id="menu"></div>

</section>

<!-- CART PAGE -->

<section id="cart" class="hidden">

    <h2 class="section-title">🛒 Your Shopping Cart</h2>

    <div class="panel">
        <div id="cartItems"></div>

        <div class="total">
            <p>Subtotal: ₹<span id="subtotal">0</span></p>
            <p>GST (5%): ₹<span id="tax">0</span></p>
            <h3>Total: ₹<strong id="grandTotal">0</strong></h3>
        </div>

        <button class="btn" onclick="checkout()">
            Proceed to Checkout
        </button>
    </div>

</section>

<!-- CHECKOUT PAGE -->

<section id="checkout" class="hidden">

    <h2 class="section-title">💳 Checkout</h2>

    <div class="panel">

        <h3>Customer Details</h3><br>

        <input id="studentName" placeholder="Student Name" required>
        <br><br>

        <input id="studentId" placeholder="College ID" required>
        <br><br>

        <select id="payment">
            <option value="UPI">UPI / QR Payment (Demo)</option>
            <option value="Cash">Cash at Counter</option>
        </select>

        <br><br>

        <div id="paymentQR" class="hidden">
            <h3>Demo QR Payment</h3>
            <p>Scan this demonstration QR code using your imagination or use the demo payment button.</p>
            <div style="font-size:100px;text-align:center">▦</div>
            <button class="btn" onclick="placeOrder()">
                Simulate Successful Payment
            </button>
        </div>

        <button id="placeBtn" class="btn"
            onclick="placeOrder()">
            Confirm Cash Order
        </button>

        <br><br>
        <button class="btn" style="background:#555"
            onclick="showPage('cart')">
            Back to Cart
        </button>

    </div>
</section>

<!-- ORDER PAGE -->

<section id="orders" class="hidden">

    <h2 class="section-title">📦 My Orders</h2>

    <div id="orderHistory"></div>

</section>

<!-- ADMIN PAGE -->

<section id="admin" class="hidden">

    <h2 class="section-title">⚙️ Admin Dashboard</h2>

    <div class="panel">
        <h3>Add New Food Item</h3>

        <div class="admin-grid">
            <input id="newName" placeholder="Food Name">
            <input id="newPrice" type="number" placeholder="Price">
            <input id="newEmoji" placeholder="Food Emoji 🍕">
            <select id="newCategory">
                <option>Snacks</option>
                <option>Meals</option>
                <option>Drinks</option>
                <option>Desserts</option>
            </select>
            <input id="newStock" type="number" placeholder="Stock quantity">
        </div>

        <button class="btn" onclick="addFood()">
            Add Food Item
        </button>
    </div>

    <div class="panel">
        <h3>Inventory Management</h3>
        <div id="inventory"></div>
    </div>

    <div class="panel">
        <h3>Manage All Orders</h3>
        <div id="allOrders"></div>
    </div>

    <div class="panel">
        <h3>📊 Sales Statistics</h3>
        <h2>₹<span id="sales">0</span></h2>
        <p>Total Revenue</p>
        <br>
        <p>Total Orders: <strong id="orderCount">0</strong></p>
    </div>

</section>

<!-- REVIEW SECTION -->

<section class="panel" id="reviewSection">

    <h2>⭐ Rate Your Experience</h2>
    <br>

    <select id="rating">
        <option value="5">⭐⭐⭐⭐⭐ Excellent</option>
        <option value="4">⭐⭐⭐⭐ Good</option>
        <option value="3">⭐⭐⭐ Average</option>
        <option value="2">⭐⭐ Poor</option>
        <option value="1">⭐ Very Poor</option>
    </select>

    <br><br>

    <textarea id="reviewText"
        placeholder="Write your feedback..."
        style="width:100%;height:90px"></textarea>

    <button class="btn" onclick="submitReview()">
        Submit Review
    </button>

    <br><br>
    <h3>Customer Reviews</h3>
    <div id="reviews"></div>

</section>

</main>

<footer>
    <h3>🍔 Smart Canteen Management System</h3>
    <p>College Food Ordering Made Easy</p>
    <p>Mini Project | HTML CSS JavaScript</p>
</footer>

<div id="toast"></div>

<script>

// INITIAL FOOD DATABASE

const defaultFoods = [
    {id:1,name:"Veg Burger",price:60,emoji:"🍔",category:"Snacks",stock:20},
    {id:2,name:"Pizza",price:120,emoji:"🍕",category:"Snacks",stock:15},
    {id:3,name:"French Fries",price:50,emoji:"🍟",category:"Snacks",stock:25},
    {id:4,name:"Sandwich",price:70,emoji:"🥪",category:"Snacks",stock:20},
    {id:5,name:"Veg Thali",price:100,emoji:"🍛",category:"Meals",stock:12},
    {id:6,name:"Paneer Rice",price:110,emoji:"🍚",category:"Meals",stock:10},
    {id:7,name:"Cold Coffee",price:60,emoji:"☕",category:"Drinks",stock:20},
    {id:8,name:"Fresh Juice",price:45,emoji:"🧃",category:"Drinks",stock:15},
    {id:9,name:"Ice Cream",price:40,emoji:"🍨",category:"Desserts",stock:18}
];

// LOAD DATA FROM LOCAL STORAGE

let foods = JSON.parse(localStorage.getItem("foods")) || defaultFoods;
let cart = JSON.parse(localStorage.getItem("cart")) || [];
let orders = JSON.parse(localStorage.getItem("orders")) || [];
let reviews = JSON.parse(localStorage.getItem("reviews")) || [];

let selectedCategory = "All";

// SAVE DATA

function saveData() {
    localStorage.setItem("foods",JSON.stringify(foods));
    localStorage.setItem("cart",JSON.stringify(cart));
    localStorage.setItem("orders",JSON.stringify(orders));
    localStorage.setItem("reviews",JSON.stringify(reviews));
}

// NOTIFICATION

function notify(message) {
    const toast = document.getElementById("toast");
    toast.innerText = message;
    toast.style.display = "block";

    setTimeout(() => {
        toast.style.display = "none";
    },2500);
}

// PAGE NAVIGATION

function showPage(page) {

    document.querySelectorAll("main section").forEach(section => {
        section.classList.add("hidden");
    });

    document.getElementById(page).classList.remove("hidden");

    if(page === "cart") renderCart();
    if(page === "orders") renderOrders();
    if(page === "admin") renderAdmin();

    window.scrollTo(0,0);
}

// CATEGORY FILTER

function renderCategories() {

    const categories = ["All","Snacks","Meals","Drinks","Desserts"];

    document.getElementById("categories").innerHTML =
        categories.map(category => `
            <button class="category ${selectedCategory === category ? "active" : ""}"
                onclick="filterCategory('${category}')">
                ${category}
            </button>
        `).join("");
}

function filterCategory(category) {
    selectedCategory = category;
    renderCategories();
    renderMenu();
}

// DISPLAY MENU

function renderMenu() {

    const search = document.getElementById("search").value.toLowerCase();
    const sort = document.getElementById("sort").value;

    let filtered = foods.filter(food => {

        return food.name.toLowerCase().includes(search) &&
        (selectedCategory === "All" ||
        food.category === selectedCategory);

    });

    if(sort === "low") filtered.sort((a,b) => a.price-b.price);
    if(sort === "high") filtered.sort((a,b) => b.price-a.price);

    document.getElementById("menu").innerHTML =
        filtered.map(food => `

        <div class="food-card">

            <div class="food-image">${food.emoji}</div>

            <div class="food-info">

                <h3>${food.name}</h3>

                <p>${food.category}</p>

                <p>Available: ${food.stock}</p>

                <div class="price">₹${food.price}</div>

                <button class="btn"
                    onclick="addToCart(${food.id})"
                    ${food.stock <= 0 ? "disabled" : ""}>
                    ${food.stock <= 0 ? "Out of Stock" : "Add to Cart"}
                </button>

            </div>
        </div>

        `).join("") || "<p>No food items found.</p>";
}

// ADD TO CART

function addToCart(id) {

    const food = foods.find(item => item.id === id);

    const existing = cart.find(item => item.id === id);

    if(!food || food.stock <= 0) {
        notify("Food unavailable!");
        return;
    }

    if(existing) {

        if(existing.quantity >= food.stock) {
            notify("Maximum available stock reached!");
            return;
        }

        existing.quantity++;

    } else {

        cart.push({
            id:food.id,
            name:food.name,
            price:food.price,
            quantity:1
        });

    }

    saveData();
    updateCartCount();
    notify(food.name + " added to cart!");
}

// CART QUANTITY

function changeQuantity(id,change) {

    const item = cart.find(item => item.id === id);
    const food = foods.find(item => item.id === id);

    if(!item) return;

    if(change > 0 && item.quantity >= food.stock) {
        notify("Stock limit reached!");
        return;
    }

    item.quantity += change;

    if(item.quantity <= 0) {
        cart = cart.filter(item => item.id !== id);
    }

    saveData();
    renderCart();
    updateCartCount();
}

// CART DISPLAY

function renderCart() {

    const container = document.getElementById("cartItems");

    if(cart.length === 0) {
        container.innerHTML = "<h3>Your cart is empty!</h3>";
    } else {

        container.innerHTML = cart.map(item => `

            <div class="cart-item">

                <div>
                    <strong>${item.name}</strong>
                    <p>₹${item.price} × ${item.quantity}</p>
                </div>

                <div>
                    <button onclick="changeQuantity(${item.id},-1)">−</button>
                    <strong>${item.quantity}</strong>
                    <button onclick="changeQuantity(${item.id},1)">+</button>
                </div>

                <strong>₹${item.price*item.quantity}</strong>

            </div>

        `).join("");

    }

    let subtotal = cart.reduce(
        (sum,item) => sum + item.price*item.quantity,0
    );

    let tax = Math.round(subtotal*0.05);

    document.getElementById("subtotal").innerText = subtotal;
    document.getElementById("tax").innerText = tax;
    document.getElementById("grandTotal").innerText = subtotal+tax;
}

function updateCartCount() {

    const count = cart.reduce(
        (sum,item) => sum+item.quantity,0
    );

    document.getElementById("cartCount").innerText = count;
}

// CHECKOUT

document.getElementById("payment").addEventListener("change",function() {

    const upi = this.value === "UPI";

    document.getElementById("paymentQR").classList.toggle("hidden",!upi);
    document.getElementById("placeBtn").classList.toggle("hidden",upi);

});

function checkout() {

    if(cart.length === 0) {
        notify("Your cart is empty!");
        return;
    }

    showPage("checkout");
}

// PLACE ORDER

function placeOrder() {

    const name = document.getElementById("studentName").value.trim();
    const studentId = document.getElementById("studentId").value.trim();
    const payment = document.getElementById("payment").value;

    if(!name || !studentId) {
        notify("Please enter your details!");
        return;
    }

    // Check stock before confirming

    for(const item of cart) {

        const food = foods.find(f => f.id === item.id);

        if(!food || food.stock < item.quantity) {
            notify(item.name + " is out of stock!");
            return;
        }

    }

    const subtotal = cart.reduce(
        (sum,item) => sum+item.price*item.quantity,0
    );

    const tax = Math.round(subtotal*0.05);

    const order = {

        id:Date.now(),
        name:name,
        studentId:studentId,
        items:[...cart],
        total:subtotal+tax,
        payment:payment,
        status:"Received",
        date:new Date().toLocaleString()

    };

    // Reduce inventory

    cart.forEach(item => {

        const food = foods.find(f => f.id === item.id);

        food.stock -= item.quantity;

    });

    orders.unshift(order);

    cart = [];

    saveData();
    updateCartCount();

    notify("Order placed successfully!");

    showPage("orders");
}

// STUDENT ORDER HISTORY

function renderOrders() {

    const container = document.getElementById("orderHistory");

    if(orders.length === 0) {
        container.innerHTML = "<p>No orders yet.</p>";
        return;
    }

    container.innerHTML = orders.map(order => `

        <div class="order">

            <h3>Order #${order.id.toString().slice(-6)}</h3>

            <p>Student: ${order.name}</p>

            <p>College ID: ${order.studentId}</p>

            <p>Date: ${order.date}</p>

            <p>Payment: ${order.payment}</p>

            <p>Total: ₹${order.total}</p>

            <p class="status">Status: ${order.status}</p>

            <p>Items: ${order.items.map(i =>
                i.name+" × "+i.quantity).join(", ")}</p>

        </div>

    `).join("");
}

// ADMIN: ADD FOOD

function addFood() {

    const name = document.getElementById("newName").value.trim();
    const price = Number(document.getElementById("newPrice").value);
    const emoji = document.getElementById("newEmoji").value.trim() || "🍽️";
    const category = document.getElementById("newCategory").value;
    const stock = Number(document.getElementById("newStock").value);

    if(!name || !Number.isFinite(price) || price <= 0 ||
       !Number.isInteger(stock) || stock < 0) {
        notify("Enter valid food details!");
        return;
    }

    foods.push({

        id:Date.now(),
        name:name,
        price:price,
        emoji:emoji,
        category:category,
        stock:stock

    });

    saveData();
    renderAdmin();
    renderMenu();

    document.getElementById("newName").value = "";
    document.getElementById("newPrice").value = "";
    document.getElementById("newEmoji").value = "";
    document.getElementById("newStock").value = "";

    notify("New food item added!");
}

// ADMIN INVENTORY

function renderAdmin() {

    document.getElementById("inventory").innerHTML =
        foods.map(food => `

        <div class="cart-item">

            <div>
                ${food.emoji} <strong>${food.name}</strong>
                <p>Price: ₹${food.price} | Stock: ${food.stock}</p>
            </div>

            <button onclick="restock(${food.id})">
                +10 Stock
            </button>

            <button onclick="deleteFood(${food.id})">
                Delete
            </button>

        </div>

    `).join("");

    document.getElementById("allOrders").innerHTML =
        orders.map(order => `

        <div class="order">

            <h3>Order #${order.id.toString().slice(-6)}</h3>

            <p>${order.name} | ₹${order.total}</p>

            <p>Status: ${order.status}</p>

            <select onchange="updateStatus(${order.id},this.value)">
                ${["Received","Preparing","Ready","Completed","Cancelled"]
                    .map(status => `
                    <option value="${status}"
                    ${order.status===status?"selected":""}>
                    ${status}
                    </option>
                `).join("")}
            </select>

        </div>

    `).join("") || "<p>No orders received.</p>";

    const completedSales = orders
        .filter(order => order.status === "Completed")
        .reduce((sum,order) => sum+order.total,0);

    document.getElementById("sales").innerText = completedSales;

    document.getElementById("orderCount").innerText = orders.length;
}

// UPDATE INVENTORY

function restock(id) {

    const food = foods.find(item => item.id === id);

    if(!food) return;

    food.stock += 10;

    saveData();
    renderAdmin();
    renderMenu();

    notify("Inventory updated!");
}

// DELETE FOOD

function deleteFood(id) {

    if(!confirm("Delete this food item?")) return;

    foods = foods.filter(food => food.id !== id);

    cart = cart.filter(item => item.id !== id);

    saveData();

    renderAdmin();
    renderMenu();
    updateCartCount();

    notify("Food item deleted!");
}

// UPDATE ORDER STATUS

function updateStatus(id,status) {

    const order = orders.find(item => item.id === id);

    if(!order) return;

    if(order.status === "Cancelled" || order.status === "Completed") {
        notify("This order is already finalized!");
        renderAdmin();
        return;
    }

    if(status === "Cancelled") {

        order.items.forEach(item => {

            const food = foods.find(f => f.id === item.id);

            if(food) food.stock += item.quantity;

        });

    }

    order.status = status;

    saveData();

    renderAdmin();
    renderMenu();

    notify("Order status updated!");
}

// REVIEWS

function submitReview() {

    const rating = document.getElementById("rating").value;
    const reviewText = document.getElementById("reviewText").value.trim();

    if(!reviewText) {
        notify("Please write a review!");
        return;
    }

    reviews.unshift({

        rating:rating,
        text:reviewText,
        date:new Date().toLocaleDateString()

    });

    saveData();

    document.getElementById("reviewText").value = "";

    renderReviews();

    notify("Thank you for your feedback!");
}

function renderReviews() {

    document.getElementById("reviews").innerHTML =
        reviews.map(review => `

        <div class="order">

            <p>${"⭐".repeat(Number(review.rating))}</p>

            <p>${review.text}</p>

            <small>${review.date}</small>

        </div>

    `).join("") || "<p>No reviews yet.</p>";
}

// INITIALIZE APP

renderCategories();
renderMenu();
renderCart();
renderReviews();
updateCartCount();

</script>

</body>
</html>
